# Account configuration for scripts/setup-repo.sh. aes-new creates it the first time; by hand, once
# per GitHub account, outside any repository: ~/.config/aes/app.env.
# It contains no secrets: the private key stays in its .pem file, which never goes to git.

# The agents' GitHub App (Settings → Developer settings → GitHub Apps → your app).
AES_APP_ID=123456                     # General page → "App ID"
AES_APP_INSTALLATION_ID=12345678      # the installation's URL: .../settings/installations/<id>
AES_APP_PRIVATE_KEY=C:/Users/your-user/.config/aes/aes-agent.pem   # with forward slashes
AES_BOT_SLUG=aes-agent-key            # the app's slug (its user is <slug>[bot])
# AES_BOT_ID=                         # optional: the script looks it up if it is missing

# Who can put on the aes:* labels and approves the protected paths (CODEOWNERS uses the first one).
# Optional: your gh user by default.
# AES_APPROVERS=your-user

# Roles in OpenCode (AES 06 §12): QA, programmer and mechanic run there with this model in each
# new project; the verifier stays in Claude. Empty or "claude" = all in Claude Code.
# Examples: deepseek/deepseek-flash (paid), opencode/deepseek-v4.1-flash-free (free for a limited time).
# AES_OPENCODE_MODEL=deepseek/deepseek-flash

# Third-party skills installed in each project, at the version you have in these folders
# (separated by ;). Example with archify and impeccable cloned in ~/.config/aes/skills/:
# AES_VENDOR="~/.config/aes/skills/archify/archify;~/.config/aes/skills/impeccable/.claude/skills/impeccable"
