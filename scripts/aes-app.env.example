# Configuración de la cuenta para scripts/setup-repo.sh. La crea aes-new la primera vez; a mano, una vez
# por cuenta de GitHub, fuera de cualquier repositorio: ~/.config/aes/app.env.
# No contiene secretos: la llave privada se queda en su archivo .pem, que nunca va a git.

# GitHub App de los agentes (Settings → Developer settings → GitHub Apps → tu app).
AES_APP_ID=123456                     # página General → "App ID"
AES_APP_INSTALLATION_ID=12345678      # URL de la instalación: .../settings/installations/<id>
AES_APP_PRIVATE_KEY=C:/Users/tu-usuario/.config/aes/aes-agent.pem   # con barras normales
AES_BOT_SLUG=aes-agent-key            # el slug de la app (su usuario es <slug>[bot])
# AES_BOT_ID=                         # opcional: el script lo consulta si falta

# Quién puede poner las etiquetas aes:* y aprueba las rutas protegidas (CODEOWNERS usa el primero).
# Opcional: por defecto, tu usuario de gh.
# AES_APPROVERS=tu-usuario

# Roles en OpenCode (AES 06 §12): QA, programador y mecánico corren ahí con este modelo en cada
# proyecto nuevo; el verificador sigue en Claude. Vacío o "claude" = todos en Claude Code.
# Ejemplos: opencode/deepseek-v4.1-flash-free (gratis por tiempo limitado), deepseek/deepseek-flash.
# AES_OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# Skills de terceros que se instalan en cada proyecto, en la versión que tengas en estas carpetas
# (separadas por ;). Ejemplo con archify e impeccable clonados en ~/.config/aes/skills/:
# AES_VENDOR="~/.config/aes/skills/archify/archify;~/.config/aes/skills/impeccable/.claude/skills/impeccable"
