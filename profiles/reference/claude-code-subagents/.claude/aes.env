# AES — project configuration for the hooks and scripts in .claude/ (it contains no secrets).
# Loaded by .claude/hooks/subagent-gate.sh and the scripts with-servers.sh, aes-oc.sh and aes-doctor.sh.
# Example values: a .NET API on :5080 and a Vite web app on :5173. Replace them with your stack's.

# Ports no role may leave taken when it finishes (06 §10).
AES_PORTS="5080 5173"

# Servers for the agentic manual test (with-servers.sh).
AES_API_CMD="dotnet run --project src/MyApp.Api --urls http://localhost:5080"
AES_API_HEALTH="http://localhost:5080/api/health"
AES_WEB_CMD="npm --prefix web run dev -- --port 5173 --strictPort"
AES_WEB_URL="http://localhost:5173/"

# Each run's own temporary database: environment variable and value ({db} = temporary path).
AES_DB_VAR="ConnectionStrings__Default"
AES_DB_VALUE="Data Source={db}"

# Project language (00 §3): the language the agents write the project's artifacts in (stories,
# plans, backlog, notes, reports, retrospectives, messages to the human) and the language of the
# backlog board. AES itself is in English. en | es
AES_LANG="en"

# Identity the agents publish with (06 §10): "app" = the agents' GitHub App (their PRs
# appear as <app>[bot] and you approve them); "personal" = your own gh session, without an app (the
# rules require a PR and green CI, and your approval is merging the PR).
AES_IDENTITY="app"

# Role binding (standard/06 §12): where each role runs. "claude" = a Claude Code subagent with the
# model in its file in .claude/agents/; "opencode:<provider>/<model>" = OpenCode, delegated with
# .claude/scripts/aes-oc.sh. The verifier stays in Claude: it reviews a model from another family.
AES_BIND_QA="claude"
AES_BIND_PROGRAMMER="claude"
AES_BIND_MECHANIC="claude"
AES_BIND_VERIFIER="claude"
# Model levels (06 §12.1): a task can ask for another level with "**Model level:** high — <reason>"
# (the orchestrator proposes it when writing the task and you approve it in the qa/<ID> PR). Each level is
# AES_BIND_<ROLE>_<LEVEL>; without it, the role uses its default binding. "claude:<sonnet|opus|haiku>" runs
# the role as a Claude Code subagent with that model (it spends your Claude limit: only for what
# justifies it). A task can also set a concrete binding: "**Model level:** opencode:x/y".
# Spanish names (AES_BIND_<ROLE>_ALTO, "**Nivel de modelo:** alto") are accepted as aliases.
AES_BIND_PROGRAMMER_HIGH="claude:sonnet"
AES_BIND_VERIFIER_HIGH="claude:opus"
# Example with DeepSeek (key in DEEPSEEK_API_KEY or with /connect in OpenCode):
#   AES_BIND_QA="opencode:deepseek/deepseek-flash"
#   AES_BIND_PROGRAMMER="opencode:deepseek/deepseek-flash"
#   AES_BIND_MECHANIC="opencode:deepseek/deepseek-flash"
# Free while OpenCode's promotion lasts (no retention or training according to its policy). Only
# for trying things out: the free plan cuts long sessions off at its usage limit (429, seen in EN-001).
#   AES_BIND_PROGRAMMER="opencode:opencode/deepseek-v4.1-flash-free"

# Estimated cost of the roles in OpenCode: list price in USD per million (uncached input,
# output, cached input) and UTC slots, Monday to Friday, in which double is charged.
# deepseek-flash values in November 2026; with a free model, they estimate what it would have cost.
AES_OC_LIST_PRICE="0.15 0.60 0.003"
AES_OC_PEAK_UTC="1-4 6-10"
# Maximum duration of an OpenCode run, in seconds, and the wait after the model's final close.
AES_OC_TIMEOUT=3600
AES_OC_IDLE=30
# OpenCode versions aes-oc.sh was tested with (space-separated). With another one, aes-doctor.sh
# warns and checks that `opencode run` still accepts the options the script uses.
AES_OC_TESTED="1.19.5 1.19.6 2.2.7"

# Open Code Review (standard/05 §7.1): the deterministic part of the code review. In delegation mode
# (.claude/scripts/aes-ocr.sh) it calls no model: the programmer reads the checklist of its surface
# before coding and the verifier reviews the diff with it and reports coverage. 1 = on, 0 = off.
# The fixed version is installed once in .aes/tools/ (npm). The second review in CI (native mode) is
# configured in GitHub: secret AES_OCR_TOKEN and variables AES_OCR_URL, AES_OCR_MODEL, AES_OCR_PROTOCOL.
AES_OCR=1
AES_OCR_VERSION="1.14.4"
# Family of the model of that second review (for aes-doctor.sh: it warns if it is the programmer's).
#   AES_OCR_CI_FAMILY="qwen"

# Stack checks for aes-doctor.sh: one per line, "description|command" (it passes if it exits with
# 0). "probe:rust", "probe:dotnet" or "probe:node" build a minimal project in a temporary folder:
# they detect a compiler without a linker or without an SDK before delegating. The orchestrator
# proposes them once there is a stack ADR (EN-001).
AES_DOCTOR_CHECKS="
.NET SDK (minimal build)|probe:dotnet
Node and npm|probe:node
"
