# AES — configuración del proyecto para los hooks y scripts de .claude/ (no contiene secretos).
# Lo cargan .claude/hooks/subagent-gate.sh y los scripts with-servers.sh, aes-oc.sh y aes-doctor.sh.
# Valores de ejemplo: API .NET en :5080 y web Vite en :5173. Sustitúyelos por los de tu stack.

# Puertos que ningún rol puede dejar ocupados al terminar (06 §10).
AES_PORTS="5080 5173"

# Servidores para la prueba manual agéntica (with-servers.sh).
AES_API_CMD="dotnet run --project src/MiApp.Api --urls http://localhost:5080"
AES_API_HEALTH="http://localhost:5080/api/health"
AES_WEB_CMD="npm --prefix web run dev -- --port 5173 --strictPort"
AES_WEB_URL="http://localhost:5173/"

# Base de datos temporal propia de cada ejecución: variable de entorno y valor ({db} = ruta temporal).
AES_DB_VAR="ConnectionStrings__Default"
AES_DB_VALUE="Data Source={db}"

# Identidad con la que publican los agentes (06 §10): "app" = GitHub App de los agentes (sus PR
# aparecen como <app>[bot] y tú los apruebas); "personal" = tu propia sesión de gh, sin app (las
# reglas exigen PR y CI en verde, y tu aprobación es integrar el PR).
# Project language: the language agents write the project's artifacts in (stories, backlog, notes,
# reports, retrospectives) and the language of the backlog board. AES itself is in English; the
# templates' headings are translated when the project language is not English. en | es
AES_LANG="en"

AES_IDENTITY="app"

# Binding de roles (standard/06 §12): dónde corre cada rol. "claude" = subagente de Claude Code con el
# modelo de su archivo en .claude/agents/; "opencode:<proveedor>/<modelo>" = OpenCode, delegado con
# .claude/scripts/aes-oc.sh. El verificador se queda en Claude: revisa un modelo de otra familia.
AES_BIND_QA="claude"
AES_BIND_PROGRAMMER="claude"
AES_BIND_MECHANIC="claude"
AES_BIND_VERIFIER="claude"
# Niveles de modelo (06 §12.1): una tarea puede pedir otro nivel con «**Nivel de modelo:** alto — <motivo>»
# (lo propone el orquestador al escribir la tarea y lo apruebas en el PR qa/<ID>). Cada nivel es
# AES_BIND_<ROL>_<NIVEL>; sin él, el rol usa su binding por defecto. «claude:<sonnet|opus|haiku>» corre
# el rol como subagente de Claude Code con ese modelo (gasta tu límite de Claude: solo para lo que lo
# justifica). Una tarea también puede fijar un binding concreto: «**Nivel de modelo:** opencode:x/y».
AES_BIND_PROGRAMMER_ALTO="claude:sonnet"
AES_BIND_VERIFIER_ALTO="claude:opus"
# Ejemplo con DeepSeek (clave en DEEPSEEK_API_KEY o con /connect en OpenCode):
#   AES_BIND_QA="opencode:deepseek/deepseek-flash"
#   AES_BIND_PROGRAMMER="opencode:deepseek/deepseek-flash"
#   AES_BIND_MECHANIC="opencode:deepseek/deepseek-flash"
# Gratis mientras dure la promoción de OpenCode (sin retención ni entrenamiento según su política). Solo
# para probar: el plan gratuito corta las sesiones largas por límite de uso (429, se vio en EN-001).
#   AES_BIND_PROGRAMMER="opencode:opencode/deepseek-v4.1-flash-free"

# Costo estimado de los roles en OpenCode: precio de lista en USD por millón (entrada sin caché,
# salida, entrada en caché) y franjas UTC de lunes a viernes en las que se cobra el doble.
# Valores de deepseek-flash en noviembre de 2026; con un modelo gratuito, estiman lo que habría costado.
AES_OC_LIST_PRICE="0.15 0.60 0.003"
AES_OC_PEAK_UTC="1-4 6-10"
# Tiempo máximo de una ejecución de OpenCode, en segundos, y espera tras el cierre final del modelo.
AES_OC_TIMEOUT=3600
AES_OC_IDLE=30
# Versiones de OpenCode con las que se probó aes-oc.sh (separadas por espacio). Con otra, aes-doctor.sh
# avisa y comprueba que `opencode run` siga aceptando las opciones que usa el script.
AES_OC_TESTED="1.19.5 1.19.6 2.2.7"

# Comprobaciones del stack para aes-doctor.sh: una por línea, «descripción|comando» (pasa si sale con
# 0). «probe:rust», «probe:dotnet» o «probe:node» compilan un proyecto mínimo en una carpeta temporal:
# detectan un compilador sin enlazador o sin SDK antes de delegar. Las propone el orquestador cuando
# hay ADR del stack (EN-001).
AES_DOCTOR_CHECKS="
.NET SDK (compilación mínima)|probe:dotnet
Node y npm|probe:node
"
