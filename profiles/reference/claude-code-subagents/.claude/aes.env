# AES — configuración del proyecto para los hooks y scripts de .claude/ (no contiene secretos).
# Lo cargan .claude/hooks/subagent-gate.sh y .claude/scripts/with-servers.sh.
# Valores de ejemplo: API .NET en :5080 y web Vite en :5173. Sustitúyelos por los de tu stack.

# Puertos que ningún rol puede dejar ocupados al terminar (06 §10).
AES_PORTS="5080 5173"

# Servidores para la prueba manual agéntica (with-servers.sh).
AES_API_CMD="dotnet run --project src/MiApp.Api --urls http://localhost:5080"
AES_API_HEALTH="http://localhost:5080/api/health"
AES_WEB_CMD="npm --prefix web run dev -- --port 5173 --strictPort"
AES_WEB_URL="http://localhost:5173/"

# Base de datos temporal propia de cada ejecución: variable de entorno y valor ({db} = ruta temporal).
AES_DB_VAR="ConnectionStrings__Default"
AES_DB_VALUE="Data Source={db}"
